{% extends 'base.html.twig' %}

{% block title %}Détails de la Série{% endblock %}

{% block body %}
    <style>
        body {
            background-color: #211d1c;
            color: #e8e0d5;
            font-family:
                system-ui,
                -apple-system,
                sans-serif;
        }

        .main-serie-img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid rgba(216, 147, 67, 0.3);
        }

        .suggestion-card {
            background-color: #2a2523;
            border: 1px solid #3d3532;
            border-radius: 6px;
            overflow: hidden;
            transition:
                transform 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .suggestion-card:hover {
            transform: translateY(-4px);
            border-color: #d89343;
            box-shadow: 0 4px 15px rgba(216, 147, 67, 0.15);
        }

        .suggestion-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
        }

        .suggestion-title {
            padding: 10px 12px;
            margin: 0;
            font-size: 0.9rem;
            font-weight: 500;
            color: #e8e0d5;
            background-color: #241f1e;
        }
    </style>

    <div class="container py-5 text-white">
        <!-- Section Principale : Image à gauche, Détails à droite -->
        <div class="row g-4 align-items-center mb-5">
            <div class="col-md-5 col-lg-4">
                <img src="{{ serie.image }}" class="main-serie-img shadow" alt="{{ serie.titre }}">
            </div>
            <div class="col-md-7 col-lg-8 ps-md-4">
                <h1 class="display-4 fw-normal mb-2">{{ serie.titre }}</h1>
                
                <p class="text-secondary small mb-3">{{ serie.premiereDiffusion|date('d/m/Y H:i') }}</p>

                <p class="lead fs-6 text-light opacity-75 mb-4">
                    {{ serie.resume }}
                </p>

                <p class="fw-bold mb-0">
                    Nombre d'épisodes : <span class="fw-normal">{{ serie.nbEpisodes }}</span>
                </p>
                <p class="fw-bold mb-0">
                    Pays : <span class="fw-normal">{{ serie.lePays.Nom }}</span>
                </p>
                <p class="fw-bold mb-0">
                    Genres :
                    {% for genreSerie in serie.lesGenres %}
                        <span class="fw-normal">{{ genreSerie.libelle }} </span>
                    {% endfor %}
                </p>

            </div>
        </div>
{% endblock %}
