{% extends 'base.html.twig' %}

{% block title %}Catalogue des Séries{% endblock %}

{% block body %}
    <style>
        .serie-card {
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }

        .serie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15) !important;
        }

        .serie-img-container {
            height: 320px;
            overflow: hidden;
            background-color: #f8f9fa;
        }

        .serie-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>

    <div class="container py-5">
        <div class="row mb-4 text-center">
            <div class="col">
                <h1 class="fw-bold display-5 text-primary">Nos Séries</h1>
                <p class="text-muted">Découvrez notre sélection de séries du moment</p>
                <hr class="w-25 mx-auto text-primary opacity-75">
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            {% for listSerie in series %}
                <div class="col">
                    <div class="card h-100 shadow-sm serie-card">
                        <div class="serie-img-container">
                            <img src="{{ listSerie.image }}" class="serie-img" alt="{{ listSerie.titre }}">
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between text-center">
                            <button><a class="card-title fw-bold text-dark mb-0" href="{{ path('serie_list', {id: listSerie.id}) }}">{{ listSerie.titre }}</a></button>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <p class="text-muted fs-5">Aucune série disponible pour le moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}