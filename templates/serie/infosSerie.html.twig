{% extends 'base.html.twig' %}

{% block title %}Détails de la Série{% endblock %}

{% block body %}
    <style>
        body {
            background-color: #1a1d20;
            color: #f8f9fa;
        }

        .main-serie-img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 8px;
        }

        .suggestion-card {
            background-color: #212529;
            border: 1px solid #343a40;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .suggestion-card:hover {
            transform: translateY(-4px);
            border-color: #6c757d;
        }

        .suggestion-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
        }

        .suggestion-title {
            padding: 10px 12px;
            margin: 0;
            font-size: 0.9rem;
            font-weight: 500;
            color: #e9ecef;
            background-color: #1a1d20;
        }
    </style>

    <div class="container py-5 text-white">
        <!-- Section Principale : Image à gauche, Détails à droite -->
        <div class="row g-4 align-items-center mb-5">
            <div class="col-md-5 col-lg-4">
                <img src="{{ uneSerie.image }}" class="main-serie-img shadow" alt="{{ uneSerie.titre }}">
            </div>
            <div class="col-md-7 col-lg-8 ps-md-4">
                <h1 class="display-4 fw-normal mb-2">{{ uneSerie.titre }}</h1>
                
                <p class="text-secondary small mb-3">{{ uneSerie.premiereDiffusion|date('d/m/Y H:i') }}</p>

                <p class="lead fs-6 text-light opacity-75 mb-4">
                    {{ uneSerie.resume }}
                </p>

                <p class="fw-bold mb-0">
                    Nombre d'épisodes : <span class="fw-normal">{{ uneSerie.nbEpisodes }}</span>
                </p>
            </div>
        </div>

        <!-- Section Suggestions -->
       <div class="pt-4 border-top border-secondary opacity-50 mb-3"></div>

<h5 class="fw-semibold mb-4">En manque d'idées ? Voici 3 suggestions</h5>

<div class="row g-3">
    {% for uneCollection in serieCollection %}
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <img src ="{{uneCollection.image}}" class="serie-img" alt="{{ uneCollection.titre }}">
                <div class="card-body">
                    <h6 class="card-title fw-bold">{{ uneCollection.titre }}</h6>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <p class="text-muted">Aucune suggestion disponible pour le moment.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}