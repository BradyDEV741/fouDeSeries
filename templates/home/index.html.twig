{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    <h1>
        {% if 'Séries' in controller_name %}
            <h1 class="text-center">{{ controller_name|upper }}!</h1>
        {% else %}
            <p>Ce site n'est pas pour les amateurs de séries</p>
        {% endif %}
    </h1>

    <div class="example-wrapper">
        <h1 class="text-center">
            <img src="{{ asset('images/fortnite.png') }}" alt="Symfony!" width="600" height="400"/>
            <h6 class="text-center">Ne me spoil pas !!!!!!!!!!!</h6>
        </h1>
    </div>
{% endblock %}
